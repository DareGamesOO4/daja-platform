{
  "name": "daja-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "npm run build:packages && npm-run-all --parallel dev:api dev:worker",
    "dev:api": "npm --workspace @daja/api run dev",
    "dev:worker": "npm --workspace @daja/worker run dev",
    "build": "npm-run-all build:packages build:apps",
    "build:packages": "npm --workspace @daja/config run build && npm --workspace @daja/observability run build && npm --workspace @daja/security run build && npm --workspace @daja/shared run build && npm --workspace @daja/validation run build && npm --workspace @daja/contracts run build && npm --workspace @daja/database run build",
    "build:apps": "npm --workspace @daja/api run build && npm --workspace @daja/worker run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "npm-run-all test:unit test:integration",
    "test:unit": "npm run build:packages && vitest run --project unit",
    "test:integration": "npm run build:packages && vitest run --project integration --pool=forks --maxWorkers=1 --fileParallelism=false",
    "db:migrate": "tsx packages/database/src/cli.ts migrate",
    "db:status": "tsx packages/database/src/cli.ts status",
    "db:seed:dev": "tsx scripts/seed-dev.ts",
    "plan2:perf": "tsx scripts/plan2-performance-fixture.ts",
    "plan3:perf": "tsx scripts/plan3-performance.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "npm run openapi:generate && node -e \"JSON.parse(require('fs').readFileSync('packages/contracts/generated/openapi.json','utf8')); console.log('openapi valid')\"",
    "preflight:production": "tsx scripts/preflight-production.ts",
    "backup:restore:drill": "tsx scripts/backup-restore-drill.ts",
    "check:no-demo": "tsx scripts/check-no-demo.ts",
    "security:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/testing": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.6",
    "argon2": "^0.43.1",
    "bullmq": "^5.58.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.3",
    "socket.io": "^4.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "js-yaml": "5.2.3",
    "sharp": "0.35.3"
  }
}
