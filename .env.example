NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://daja_app:daja_app_password@localhost:5432/daja_platform
REDIS_URL=redis://localhost:6379
API_PUBLIC_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
DB_POOL_MAX=10
DB_SLOW_QUERY_MS=250
JWT_ACCESS_SECRET=replace-with-32-plus-character-access-secret
JWT_REFRESH_SECRET=replace-with-32-plus-character-refresh-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
TRUSTED_IDENTITY_HEADERS=false

# Prepared for Plan 2 media work. Not required during Plan 1 startup.
R2_ACCOUNT_ID=
R2_BUCKET=dajashop-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
MEDIA_PUBLIC_BASE_URL=https://cdn.dajashop.rs/images
PUBLIC_ORGANIZATION_ID=
FIRESTORE_SERVICE_ACCOUNT_JSON=
FIRESTORE_PROJECT_ID=

# Google customer login. Configure GOOGLE_OAUTH_CALLBACK_BASE_URL when the
# callback is served through a storefront-domain proxy (for example Cloudflare).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_BASE_URL=
OAUTH_FRONTEND_REDIRECT_URL=http://localhost:5173

# Amazon SES transactional emails.
SES_REGION=eu-north-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_ACCOUNT_FROM_EMAIL=
SES_REPLY_TO_EMAIL=
# Comma-separated addresses that receive every newly placed order.
# If omitted, SES_REPLY_TO_EMAIL is used as the fallback recipient.
ORDER_NOTIFICATION_EMAILS=

# Comma-separated, verified Google/customer emails allowed to receive a staff admin session.
STOREFRONT_ADMIN_EMAILS=
OFFLINE_PACKAGE_SIGNING_PRIVATE_KEY=
OFFLINE_LEASE_SIGNING_PRIVATE_KEY=
